#
# This file was generated from CMakeLists.txt.in
#
# This file was copied and modified from https://cmake.org/examples/
#

cmake_minimum_required( VERSION 3.16 )


project(
  @PROJECT_NAME_UPPER@
  DESCRIPTION "A project that links against the t8code library."
  LANGUAGES C CXX
  VERSION "1.0.0"
)

# rudimentary version handling by setting it manually in this file
set ( @PROJECT_NAME_UPPER@_VERSION_MAJOR 1 )
set ( @PROJECT_NAME_UPPER@_VERSION_MINOR 0 )
set ( @PROJECT_NAME_UPPER@_VERSION_PATCH 0 )

# Find MPI and set compilers
find_package(MPI 3.0 COMPONENTS C REQUIRED )
set(CMAKE_C_COMPILER ${MPI_C_COMPILER})
set(CMAKE_CXX_COMPILER ${MPI_CXX_COMPILER})

#
# Enable "make test" to run all the tests
#
include( CTest )

# Populate the thirdparty libraries
include (cmake/thirdparty.cmake)

# if t8code is linked against VTK, this project will
# automatically detect it and link against VTK as well.
# We set @PROJECT_NAME_UPPER@_ENABLE_VTK to 1 in order to define our own VTK dependent macros in src/CMakeLists.txt
if (T8CODE_ENABLE_VTK)
    message ("t8code links against VTK with version ${T8CODE_VTK_VERSION_USED}")
    set (@PROJECT_NAME_UPPER@_ENABLE_VTK "1")
endif ()

# Recurse into the "src" subdirectory. This does not actually
# cause another cmake executable to run. The same process will walk through
# the project's entire directory structure.
add_subdirectory (src)

# Add executable called "@PROJECT_NAME_LOWER@_helloworld" that is built from the source file
# "@PROJECT_NAME_LOWER@_main.cxx". The extensions are automatically found.
add_executable (@PROJECT_NAME_LOWER@_helloworld @PROJECT_NAME_LOWER@_main.cxx)

# Link the executable to the @PROJECT_NAME_LOWER@ library. Since the library has
# public include directories we will use those link directories when building
# @PROJECT_NAME_LOWER@_demo.
target_link_libraries (@PROJECT_NAME_LOWER@_helloworld LINK_PUBLIC @PROJECT_NAME_LOWER@ T8CODE::T8)

# Recurse into the "test" subdirectory. This does not actually
# cause another cmake executable to run. The same process will walk through
# the project's entire directory structure.
add_subdirectory (test)
