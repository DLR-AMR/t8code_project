# googletest is fetched via FetchContent in cmake/thirdparty.cmake
# The target name will be available as "googletest"


# Function to add a test executable and register it with CTest.
# The test executable is built from the provided source files.
function( add_@PROJECT_NAME_LOWER@_test )
    set( options "" )
    set( oneValueArgs "NAME" )
    set( multiValueArgs "SOURCES" )
    cmake_parse_arguments( ADD_@PROJECT_NAME_UPPER@_TEST "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )

    # Get the path of the first file listed in the SOURCES list and use it to determine the build directory.
    list (LENGTH ADD_@PROJECT_NAME_UPPER@_TEST_SOURCES TEST_SOURCES_LENGTH)
    list(GET ADD_@PROJECT_NAME_UPPER@_TEST_SOURCES 0 TEST_SOURCE)
    get_filename_component(TEST_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/${TEST_SOURCE}" DIRECTORY)
    file(RELATIVE_PATH TEST_RELATIVE_DIR "${CMAKE_SOURCE_DIR}" "${TEST_SOURCE_DIR}")
    set(TEST_BUILD_DIR "${CMAKE_BINARY_DIR}/${TEST_RELATIVE_DIR}")

    add_executable( ${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} ${ADD_@PROJECT_NAME_UPPER@_TEST_SOURCES} )

    # Link base libraries.
    target_include_directories( ${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} PRIVATE ${CMAKE_BINARY_DIR}/src )
    target_link_libraries( ${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} PRIVATE @PROJECT_NAME_LOWER@ T8CODE::T8 GTest::gtest_main pthread )

    set_target_properties(${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "${TEST_BUILD_DIR}"
        LIBRARY_OUTPUT_DIRECTORY "${TEST_BUILD_DIR}"
        ARCHIVE_OUTPUT_DIRECTORY "${TEST_BUILD_DIR}"
    )

    # Use "mpirun -np 4" as test command
    separate_arguments (@PROJECT_NAME_UPPER@_TEST_COMMAND_LIST NATIVE_COMMAND "mpirun -np 4")
    add_test( NAME ${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} COMMAND ${@PROJECT_NAME_UPPER@_TEST_COMMAND_LIST} ${TEST_BUILD_DIR}/${ADD_@PROJECT_NAME_UPPER@_TEST_NAME} )
endfunction()

# Function to add a test executable for C++ tests.
# This function wraps the `add_@PROJECT_NAME_LOWER@_test` function to include common test sources.
# Common test sources are @PROJECT_NAME_LOWER@_gtest_main.cxx and @PROJECT_NAME_LOWER@_gtest_memory_macros.cxx
function ( add_@PROJECT_NAME_LOWER@_cpp_test)
    set( options "" )
    set( oneValueArgs "NAME" )
    set( multiValueArgs "SOURCES" )
    cmake_parse_arguments( ADD_@PROJECT_NAME_UPPER@_CPP_TEST "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN} )

    # add cpp sources to SOURCES list and call add_@PROJECT_NAME_LOWER@_test function
    list ( APPEND ADD_@PROJECT_NAME_UPPER@_CPP_TEST_SOURCES @PROJECT_NAME_LOWER@_gtest_main.cxx )
    add_@PROJECT_NAME_LOWER@_test( NAME ${ADD_@PROJECT_NAME_UPPER@_CPP_TEST_NAME} SOURCES ${ADD_@PROJECT_NAME_UPPER@_CPP_TEST_SOURCES} )
endfunction()

add_@PROJECT_NAME_LOWER@_cpp_test( NAME @PROJECT_NAME_LOWER@_gtest_example     SOURCES @PROJECT_NAME_LOWER@_gtest_example.cxx )
add_@PROJECT_NAME_LOWER@_cpp_test( NAME @PROJECT_NAME_LOWER@_gtest_vtk_linkage SOURCES @PROJECT_NAME_LOWER@_gtest_vtk_linkage.cxx )
